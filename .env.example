# Copy to `.env` and fill in the real values. `.env` itself is gitignored — never commit it.
# On Vercel add the same names under Project → Settings → Environment Variables (Production + Preview).

# --- Tool ratings: Upstash Redis (REST API) --------------------------------
# Both are required. Without them GET /api/rating answers `enabled: false`,
# POST answers 503, and tool pages render without the star widget.
TOOLDB_KV_REST_API_URL=
TOOLDB_KV_REST_API_TOKEN=

# Optional. Read-only token, used for every read. Falls back to the write token.
TOOLDB_KV_REST_API_READ_ONLY_TOKEN=

# Optional. HMAC secret used to hash voter IP + User-Agent for rate limiting.
# Falls back to TOOLDB_KV_REST_API_TOKEN. Rotating it resets every IP window.
RATING_IP_PEPPER=

# --- runtimeConfig overrides (nuxt.config.ts) ------------------------------
# These win over the plain names above whenever they are non-empty.
NUXT_RATING_REDIS_URL=
NUXT_RATING_REDIS_TOKEN=
NUXT_RATING_REDIS_READ_ONLY_TOKEN=
NUXT_RATING_IP_PEPPER=

# --- Site ------------------------------------------------------------------
# Canonical origin used by useSeo(), useCanonical() and server/routes/sitemap.xml.ts.
NUXT_PUBLIC_SITE_URL=https://tooldb.org
